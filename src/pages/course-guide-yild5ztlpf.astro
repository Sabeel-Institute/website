</html>

<style is:global>
  /* A reading column beside a sticky contents list; annotated screenshots
     sit in framed figures with numbered legends. The colours and fonts are
     the site's tokens (src/styles/global.css), under short local names. One
     light look, as the brand requires. */
  :root {
    --canvas: var(--color-canvas);
    --surface: var(--color-surface);
    --inset: var(--color-inset);
    --sage-mist: var(--color-sage-mist);
    --sage: var(--color-sage);
    --ink: var(--color-ink);
    --ink-soft: var(--color-ink-soft);
    --raspberry: var(--color-raspberry);
    --raspberry-deep: var(--color-raspberry-deep);
    --on-raspberry: var(--color-on-raspberry);
    --gold: var(--color-gold);
    --gold-text: var(--color-gold-text);
    --border: var(--color-border);
    --display: var(--font-display);
    --body: var(--font-sans);
    --label: var(--font-label);
    --mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  img { max-width: 100%; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--canvas);
    color: var(--ink);
    font: 400 16.5px/1.65 var(--body);
    padding-inline: 16px;
  }
  .wrap { max-width: 1180px; margin: 0 auto; padding-block: 40px 96px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; }
  .wrap > * { min-width: 0; }
  @media (min-width: 1000px) { .wrap { grid-template-columns: 220px minmax(0, 1fr); } }

  /* Contents */
  nav.toc { font: 500 14px/1.4 var(--label); }
  nav.toc p { margin: 0 0 10px; color: var(--gold-text); letter-spacing: .08em; text-transform: uppercase; font-weight: 700; font-size: 12.5px; }
  nav.toc ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; }
  nav.toc a { display: block; white-space: nowrap; color: var(--ink-soft); text-decoration: none; padding: 7px 12px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
  nav.toc a:hover, nav.toc a:focus-visible { color: var(--raspberry); border-color: var(--gold); }
  @media (min-width: 1000px) {
    nav.toc { position: sticky; top: 24px; align-self: start; }
    nav.toc ol { flex-direction: column; gap: 2px; overflow: visible; }
    nav.toc a { border: 0; background: none; padding: 6px 0 6px 12px; border-left: 2px solid var(--border); border-radius: 0; white-space: normal; }
    nav.toc a:hover, nav.toc a:focus-visible { border-left-color: var(--raspberry); }
  }
  a { color: var(--raspberry); text-decoration-color: var(--gold); text-underline-offset: 3px; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }

  main { min-width: 0; }
  header.intro { border-bottom: 1px solid var(--border); padding-bottom: 36px; margin-bottom: 8px; }
  .eyebrow { font: 700 13px/1.3 var(--label); letter-spacing: .09em; text-transform: uppercase; color: var(--gold-text); margin: 0; }
  h1, h2, h3 { font-family: var(--display); color: var(--raspberry); text-wrap: balance; font-weight: 700; line-height: 1.1; }
  h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); margin: 10px 0 0; }
  h2 { font-size: clamp(1.9rem, 3.4vw, 2.5rem); margin: 0; }
  h3 { font-size: 1.55rem; margin: 0; }
  .divider { display: flex; align-items: center; width: 150px; margin: 14px 0 0; }
  .divider::before, .divider::after { content: ''; height: 1px; flex: 1; background: var(--gold); }
  .divider span { width: 9px; height: 9px; background: var(--gold); transform: rotate(45deg); margin: 0 4px; }
  .lead { font-size: 1.15rem; color: var(--ink-soft); max-width: 44rem; margin: 20px 0 0; }
  p, li { max-width: 44rem; }
  section.part { padding-block: 56px 8px; border-top: 1px solid var(--border); scroll-margin-top: 16px; }
  section.part:first-of-type { border-top: 0; }
  .sub { margin-top: 40px; }
  .muted { color: var(--ink-soft); }

  /* Flow diagram */
  .flow { margin-top: 32px; display: grid; gap: 14px; align-items: center; }
  @media (min-width: 760px) { .flow { grid-template-columns: auto auto minmax(0, 1fr); } }
  .node { background: var(--surface); border: 1px solid var(--gold); border-radius: var(--radius); padding: 14px 16px; font-weight: 600; }
  .node small { display: block; font-weight: 400; color: var(--ink-soft); font-size: 14px; margin-top: 2px; }
  .node.you { background: var(--raspberry); color: var(--on-raspberry); border-color: var(--raspberry); }
