  ol.legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  ol.legend li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; align-items: start; }
  .num { width: 28px; height: 28px; border-radius: 999px; background: var(--raspberry); color: var(--on-raspberry); font: 700 14px/28px var(--body); text-align: center; box-shadow: 0 0 0 2px var(--surface); }
  ol.legend b { color: var(--ink); }
  .auto, .opt { font: 700 11px/1 var(--label); letter-spacing: .08em; text-transform: uppercase; border-radius: 999px; padding: 3px 7px; margin-left: 6px; vertical-align: 2px; white-space: nowrap; }
  .auto { color: var(--gold-text); border: 1px solid var(--gold); }
  .opt { color: var(--ink); border: 1px solid var(--sage); background: var(--sage-mist); }
  .key { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 16px; font-size: 15px; color: var(--ink-soft); }
  .key span:first-child { margin-left: 0; }
  .pair { display: grid; gap: 16px; margin-top: 18px; }
  @media (min-width: 760px) { .pair { grid-template-columns: 1fr 1fr; } }
  .pair figure { margin: 0; display: grid; gap: 10px; align-content: start; }
  .pair .frame, .stack .frame { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .pair img, .stack img { display: block; width: 100%; height: auto; }
  .stack { display: grid; gap: 14px; margin-top: 18px; }
  .stack figure { margin: 0; display: grid; gap: 8px; }
  .sample { font: 500 13px/1.4 var(--label); color: var(--ink-soft); }
  .sample b { color: var(--ink); }

  /* Stage chips */
  .stages { display: grid; gap: 12px; margin-top: 26px; }
