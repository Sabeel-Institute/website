  .outputs { display: grid; gap: 8px; }
  @media (min-width: 560px) { .outputs { grid-template-columns: 1fr 1fr; } }
  .outputs .node { font-weight: 500; }
  .flow-steps { display: grid; gap: 14px; }

  /* Callouts */
  .say { margin: 22px 0 0; background: var(--sage-mist); border-radius: var(--radius); padding: 16px 18px 16px 18px; max-width: 44rem; }
  .say .tag, .rule .tag { font: 700 12px/1 var(--label); letter-spacing: .09em; text-transform: uppercase; color: var(--ink); display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .say ul { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 6px; }
  .say li::before { content: '“'; color: var(--gold-text); font-weight: 700; margin-right: 2px; }
  .say li::after { content: '”'; color: var(--gold-text); font-weight: 700; margin-left: 1px; }
  .rule { margin: 22px 0 0; border: 1px solid var(--border); border-left: 0; border-radius: var(--radius); padding: 16px 18px; background: var(--surface); max-width: 44rem; position: relative; }
  .rule::before { content: ''; position: absolute; inset: 14px auto 14px 0; width: 3px; border-radius: 3px; background: var(--gold); }
  code, .word { font: 500 13.5px/1 var(--mono); background: var(--inset); color: var(--ink); padding: 3px 6px; border-radius: 6px; white-space: nowrap; }
  .word-line { font: 500 13px/1.4 var(--label); color: var(--ink-soft); margin-top: 10px; }

  /* Figures with numbered legends */
  figure.shot { margin: 28px 0 0; display: grid; gap: 22px; }
  @media (min-width: 900px) { figure.shot.side { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: start; } }
  figure.shot .frame { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: 0 10px 30px -18px color-mix(in srgb, var(--ink) 45%, transparent); }
  figure.shot img { display: block; width: 100%; height: auto; }
