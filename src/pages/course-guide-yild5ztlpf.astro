---
/**
 * The staff guide to the program template: what a course can show, and what
 * to ask an agent for. Unlisted: nothing on the site links to it, the
 * sitemap leaves it out, and it asks search engines not to index it. It
 * stands alone, without BaseLayout or the site's stylesheet, and takes the
 * site's colour and font tokens from global.css (see CLAUDE.md).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/dm-sans';
import globalCss from '../styles/global.css?raw';

/** The tokens this page uses, as global.css's @theme block defines them. */
const TOKENS = [
  'color-canvas', 'color-surface', 'color-inset', 'color-sage', 'color-sage-mist', 'color-ink', 'color-ink-soft',
  'color-raspberry', 'color-raspberry-deep', 'color-on-raspberry', 'color-gold', 'color-gold-text', 'color-border',
  'font-display', 'font-sans', 'font-label',
];
const theme = new Map(
  [...(/@theme\s*\{([\s\S]*?)\n\}/.exec(globalCss)?.[1] ?? '').matchAll(/^\s*--([a-z0-9-]+):\s*([^;]+);/gm)].map((m) => [m[1]!, m[2]!]),
);
const missing = TOKENS.filter((t) => !theme.has(t));
if (missing.length) throw new Error(`The course guide uses tokens global.css's @theme no longer defines: ${missing.join(', ')}.`);
const rootTokens = `:root { ${TOKENS.map((t) => `--${t}: ${theme.get(t)};`).join(' ')} }`;

const pictures = import.meta.glob<{ default: ImageMetadata }>('../assets/course-guide/*.webp', { eager: true });
/** A screenshot from src/assets/course-guide/, at half and full width. */
function shot(name: string) {
  const picture = pictures[`../assets/course-guide/${name}.webp`]?.default;
  if (!picture) throw new Error(`The course guide shows src/assets/course-guide/${name}.webp, which does not exist.`);
  return { src: picture, widths: [Math.round(picture.width / 2), picture.width] };
}
